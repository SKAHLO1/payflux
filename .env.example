# =============================================================================
# PayFlux — environment
# =============================================================================
#
# There are TWO files:
#
#   .env        — the API (backend/), Hardhat (contracts/) and the PoC script
#   .env.local  — the Next app (dashboard, checkout, demo store)
#
# `cp .env.example .env && cp .env.example .env.local` and fill in each.
#
# Nothing here is optional-by-accident: a missing value turns a capability OFF and the dashboard
# reports it as UNAVAILABLE at /dashboard/diagnostics. PayFlux never substitutes plausible data
# for a capability it does not have.
#
# Minimum to see the UI:            nothing — `npm run dev` works, everything reports UNAVAILABLE
# Minimum to price and route:       nothing (FTSOv2 is a public read)
# Minimum to verify a payment:      COSTON2_PRIVATE_KEY + PAYMENT_REGISTRY_ADDRESS
#                                   + MERCHANT_XRPL_ADDRESS
#                                   (the FDC verifier key is public and already defaulted)
# Minimum for Google sign-in:       the FIREBASE_* block, in BOTH files


###############################################################################
# .env — API, contracts, PoC
###############################################################################

# -----------------------------------------------------------------------------
# Networks — testnet only. The API refuses to start if these are inconsistent.
# -----------------------------------------------------------------------------
FLARE_NETWORK=coston2
FLARE_CHAIN_ID=114
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_EXPLORER_URL=https://coston2-explorer.flare.network

XRPL_NETWORK=testnet
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER_URL=https://testnet.xrpl.org

# -----------------------------------------------------------------------------
# Signing — testnet keys only. Never commit a real key; never put one in source.
# -----------------------------------------------------------------------------
# Pays FDC attestation request fees, PaymentRegistry writes and FAssets collateral reservations.
# Create a throwaway EVM account, then fund it: https://faucet.flare.network/coston2
COSTON2_PRIVATE_KEY=
# Only needed for `npm run contracts:deploy`. Can be the same account.
DEPLOYER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Contracts — printed by `npm run contracts:deploy`, paste the address back here
# -----------------------------------------------------------------------------
PAYMENT_REGISTRY_ADDRESS=
# Defaults to the deployer if unset.
PAYMENT_REGISTRY_ADMIN=

# -----------------------------------------------------------------------------
# Flare Data Connector
# -----------------------------------------------------------------------------
# Flare publishes an OPEN API key for the testnet verifier — it is in their FDC guides and
# starter kits, and it is not a secret. PayFlux defaults to it, so you can leave this blank and
# attestations still work. Verified: no key -> HTTP 401, this key -> HTTP 200.
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
FDC_VERIFIER_API_KEY=00000000-0000-0000-0000-000000000000
# The Data Availability layer is public on Coston2; the key is optional.
FDC_DA_LAYER_URL=https://ctn2-data-availability.flare.network
FDC_DA_LAYER_API_KEY=

# -----------------------------------------------------------------------------
# Merchant
# -----------------------------------------------------------------------------
# Where customers send XRP. Create and fund one at https://test.bithomp.com/faucet/
MERCHANT_XRPL_ADDRESS=rweDzkNwgmLopoW2DQtkBM2BcAkYxmM2pk
# Where the merchant receives FXRP / C2FLR. Can be the COSTON2_PRIVATE_KEY account's address.
MERCHANT_FLARE_ADDRESS=
MERCHANT_WEBHOOK_URL=http://localhost:3000/api/webhooks/payflux
# Must match PAYFLUX_WEBHOOK_SECRET in .env.local, or signature verification fails.
MERCHANT_WEBHOOK_SECRET=whsec_change_me_at_least_16_chars

# -----------------------------------------------------------------------------
# API surface
# -----------------------------------------------------------------------------
PORT=4000
# Bootstrap keys, `keyId:merchantId:secret`, comma-separated. Stored only as a SHA-256 digest.
# Developer-owned keys are created in the dashboard after signing in; these exist so the API,
# the tests and the demo store work before anyone has an account.
PAYFLUX_API_KEYS=key_live:merchant_demo:sk_demo_change_me_please
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PAYMENT_TTL_SECONDS=900
QUOTE_TTL_SECONDS=300
# Tolerance for amount matching, in basis points of the expected amount.
AMOUNT_TOLERANCE_BPS=50

# Per-account key limits and the default rotation grace window (hours).
MAX_API_KEYS_PER_ACCOUNT=5
API_KEY_ROTATION_GRACE_HOURS=24

# Development only. Refused in production. Every response it produces is labelled DEMO and it
# must never be used for the verification demonstration.
PAYFLUX_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Firebase Admin — REQUIRED for Google sign-in and dashboard-managed API keys.
# Also enables Firestore persistence; without it the API uses an in-memory store
# and everything is lost on restart.
# -----------------------------------------------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# The JSON file it downloads contains all three values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole PEM on one line, keeping the literal \n sequences, wrapped in quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=


###############################################################################
# .env.local — Next app
###############################################################################

# Used by the browser for public payment reads and the SSE stream.
NEXT_PUBLIC_PAYFLUX_API_URL=http://localhost:4000

# Server-side only — never exposed to the browser.
PAYFLUX_API_URL=http://localhost:4000
# The demo store's key. Use a bootstrap key from PAYFLUX_API_KEYS, or one you created in the
# dashboard — the store is just another API consumer.
PAYFLUX_SECRET_KEY=sk_demo_change_me_please
# Must match MERCHANT_WEBHOOK_SECRET in .env.
PAYFLUX_WEBHOOK_SECRET=whsec_change_me_at_least_16_chars

# -----------------------------------------------------------------------------
# Firebase Web — REQUIRED for Google sign-in.
# -----------------------------------------------------------------------------
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and config.
# These are public by design: they identify the project, they are not secrets, and Firebase
# expects them in client bundles. What protects the account is that the API verifies the
# resulting ID token server-side against Google's signing keys.
#
# Before this works, in the Firebase console:
#   1. Authentication → Sign-in method → enable Google
#   2. Authentication → Settings → Authorized domains → add localhost (and your deploy domain)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only needed if you later use Storage or Cloud Messaging.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
