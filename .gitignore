# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unanchored, so the backend, contracts and packages/* workspaces are covered
# too. npm hoists most of their dependencies to the root, but not .bin or tool caches.
node_modules/

# next.js
/.next/
/out/

# production
/build

# hardhat build output — regenerated by `npm run contracts:build` from contracts/*.sol, which is
# the actual source. Committing it means ~7 MB of solc output churning on every compile, and a
# reviewer cannot tell a real contract change from a recompile with a different solc build.
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# contracts/deployments/ is deliberately NOT ignored. A deployment record is the address the
# contract actually lives at on Coston2, not a build product — losing it means losing the link
# between this source and what is deployed.

# compiled backend — `npm run build --workspace @payflux/backend` regenerates it from src/
backend/dist/
packages/*/dist/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pglite-debug.log

# local scratch from manual runs — a payment id and a pid, meaningless to anyone else
pid.tmp
lastpay.txt

# env files — real config is never committed, but the template must be
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts